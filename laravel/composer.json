{
    "name": "metagrenade/metaforge-discord",
    "description": "Discord companion for MetaForge Laravel-Vue: role sync, notifications, and bot webhooks.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Caleb Harrod",
            "homepage": "https://github.com/MetaGrenade"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "MetaForge\\Discord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MetaForge\\Discord\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MetaForge\\Discord\\DiscordServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
